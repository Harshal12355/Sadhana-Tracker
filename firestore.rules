rules_version = '2';

// ===============================================================
// Assumed Data Model (Sadhana Valli — Habit Tracker App)
// ===============================================================
//
// Collection: users
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - theme: string (optional, 'light' | 'dark') - UI color mode
//   - selectedCityId: string (optional, max 40 chars) - ISKCON temple city ID
//   - customCalendarEvents: list (optional, max 400 items) - Imported .ics events
//   - updatedAt: string (optional, ISO-8601 timestamp, max 64 chars)
//
// Subcollection: users/{uid}/days
// Document ID: {date} (YYYY-MM-DD)
// Fields:
//   - date: string (required, 10 chars YYYY-MM-DD, matches document ID)
//   - tithi: string (required, max 200 chars)
//   - panchangaNote: string (required, max 300 chars)
//   - targetRounds: number (required, 0..192)
//   - completedRounds: number (required, 0..192)
//   - chantedBefore7AM: bool (required)
//   - readings: list (required, max 100 items)
//   - lectures: list (required, max 100 items)
//   - reflection: string (required, max 10000 chars)
//   - wakeTime: string (required, max 20 chars)
//   - mangalaArati: bool (required)
//   - beadsInRound: int (optional, 0..107) - names counted in the open round
//   - sittings: list (optional, max 20) - chant sittings, each {id, minutes, result}
//   - updatedAt: string (optional, max 64 chars)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidUserPrefs(data) {
      return hasOnlyAllowedFields(['theme', 'selectedCityId', 'customCalendarEvents', 'updatedAt']) &&
        (!('theme' in data) || data.theme in ['light', 'dark']) &&
        (!('selectedCityId' in data) || (data.selectedCityId is string && data.selectedCityId.size() <= 40)) &&
        (!('customCalendarEvents' in data) || (data.customCalendarEvents is list && data.customCalendarEvents.size() <= 400)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSitting(sitting) {
      return sitting is map
        && sitting.keys().hasOnly(['id', 'minutes', 'result'])
        && sitting.id is string && sitting.id.size() > 0 && sitting.id.size() <= 80
        && sitting.minutes in [10, 20, 30]
        && sitting.result in ['in-progress', 'grown', 'withered'];
    }

    function sittingsOk(list) {
      return list is list && list.size() <= 20
        && (list.size() < 1 || isValidSitting(list[0]))
        && (list.size() < 2 || isValidSitting(list[1]))
        && (list.size() < 3 || isValidSitting(list[2]))
        && (list.size() < 4 || isValidSitting(list[3]))
        && (list.size() < 5 || isValidSitting(list[4]))
        && (list.size() < 6 || isValidSitting(list[5]))
        && (list.size() < 7 || isValidSitting(list[6]))
        && (list.size() < 8 || isValidSitting(list[7]))
        && (list.size() < 9 || isValidSitting(list[8]))
        && (list.size() < 10 || isValidSitting(list[9]))
        && (list.size() < 11 || isValidSitting(list[10]))
        && (list.size() < 12 || isValidSitting(list[11]))
        && (list.size() < 13 || isValidSitting(list[12]))
        && (list.size() < 14 || isValidSitting(list[13]))
        && (list.size() < 15 || isValidSitting(list[14]))
        && (list.size() < 16 || isValidSitting(list[15]))
        && (list.size() < 17 || isValidSitting(list[16]))
        && (list.size() < 18 || isValidSitting(list[17]))
        && (list.size() < 19 || isValidSitting(list[18]))
        && (list.size() < 20 || isValidSitting(list[19]));
    }

    function isValidDayRecord(data, dateId) {
      return hasRequiredFields([
          'date',
          'tithi',
          'panchangaNote',
          'targetRounds',
          'completedRounds',
          'chantedBefore7AM',
          'readings',
          'lectures',
          'reflection',
          'wakeTime',
          'mangalaArati'
        ]) &&
        hasOnlyAllowedFields([
          'date',
          'tithi',
          'panchangaNote',
          'targetRounds',
          'completedRounds',
          'chantedBefore7AM',
          'readings',
          'lectures',
          'reflection',
          'wakeTime',
          'mangalaArati',
          'beadsInRound',
          'sittings',
          'updatedAt'
        ]) &&
        data.date is string && data.date == dateId && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.tithi is string && data.tithi.size() <= 200 &&
        data.panchangaNote is string && data.panchangaNote.size() <= 300 &&
        data.targetRounds is number && data.targetRounds >= 0 && data.targetRounds <= 192 &&
        data.completedRounds is number && data.completedRounds >= 0 && data.completedRounds <= 192 &&
        data.chantedBefore7AM is bool &&
        data.readings is list && data.readings.size() <= 100 &&
        data.lectures is list && data.lectures.size() <= 100 &&
        data.reflection is string && data.reflection.size() <= 10000 &&
        data.wakeTime is string && data.wakeTime.size() <= 20 &&
        data.mangalaArati is bool &&
        (!('beadsInRound' in data) ||
          (data.beadsInRound is int && data.beadsInRound >= 0 && data.beadsInRound <= 107)) &&
        (!('sittings' in data) || sittingsOk(data.sittings)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidUserPrefs(request.resource.data);
      allow delete: if isOwner(uid);

      match /days/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDayRecord(request.resource.data, date);
        allow delete: if isOwner(uid);
      }
    }
  }
}
