{
  "name": "sadhana-valli",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "(lsof -ti:8000 >/dev/null 2>&1 || backend/.venv/bin/uvicorn app.main:app --app-dir backend --reload --port 8000 &) && vite",
    "dev:frontend": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "backend/.venv/bin/pytest backend/tests -v",
    "ci": "npm run typecheck && npm test && npm run test:backend && npm run build",
    "dev:backend": "backend/.venv/bin/uvicorn app.main:app --app-dir backend --reload --port 8000",
    "docker:build": "docker build -t sadhana-valli:latest .",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
}
